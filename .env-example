IMAGE_BASE=ubuntu:24.04

# container user's UID/GID; set to match host user executing the container
# _USER_ID=1000

# optional installations; 1=enable, 0=disable
INSTALL_AIDER=0
INSTALL_BROWSER_BRAVE=0
INSTALL_BROWSER_CHROMIUM=0
INSTALL_CIRCOM=0
INSTALL_CLAUDECODE=0
INSTALL_CODEX=0
INSTALL_CYPRESS_DEPS=0
INSTALL_DEVOPS=0
INSTALL_DOCS=0
INSTALL_LLVM=0
INSTALL_NIX=0
INSTALL_NOIR=0
INSTALL_OPENCODE=0
INSTALL_PB=0
INSTALL_PLATFORMIO=0
INSTALL_TAURI=0
INSTALL_TOMB=0

# choose one:
INSTALL_NEOVIM_FROM_PPA_STABLE=0
INSTALL_NEOVIM_FROM_PPA_UNSTABLE=0
INSTALL_NEOVIM_FROM_SRC=1

# versions
VERSION_AZTEC=4.2.0
VERSION_FISH=release-4
VERSION_KPCLI=4.1.3
VERSION_LLVM=21
VERSION_NEOVIM_FROM_SRC=stable
VERSION_NODE=LTS
VERSION_OHMYOPENCODE=3.17.5
VERSION_TOMB=v2.13

# version examples
# VERSION_NEOVIM_FROM_SRC=release-0.11
# VERSION_NEOVIM_FROM_SRC=stable
# VERSION_NODE=LATEST
# VERSION_NODE=v24.12.0

# options
OPTIONS_NVIM_APPNAME=nvim-lazyvim
OPTIONS_OHMYOPENCODE=--claude=yes --gemini=yes --copilot=yes --openai=yes --opencode-zen=yes
#   --claude=<yes|no|max20> --gemini=<yes|no> --copilot=<yes|no> [--openai=<yes|no>] [--opencode-zen=<yes|no>] [--zai-coding-plan=<yes|no>]
OPTIONS_THEME=base24-gruvbox-dark-hard
#   base24-gruvbox-dark-hard, base24-tokyo-night-dark (have native nvim plugins) | any `tinty list` scheme

# Optional: Docker Model Runner (docker-compose.yml --profile models)
MODELS_BACKEND=llama.cpp # llama.cpp or vllm to match the model type (docker model reinstall-runner --backend)
MODELS_GPU=auto          # GPU support (none|auto|cuda|rocm|musa|cann) (docker model reinstall-runner --gpu)
MODELS_PRIMARY=ai/smollm2
#   See https://hub.docker.com/u/ai or https://huggingface.co/models?filter=transformers&sort=trending
#   Example models that work with 8GB GPU RAM:
#     hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_M
#     hf.co/unsloth/Qwen3.5-9B-GGUF:Q4_K_M
#     ai/qwen3:8B-Q4_K_M
MODELS_WEBUI_PORT=12444

# Optional: LLM Gateway (docker-compose.yml --profile gateway)
ENABLE_GATEWAY=0
GATEWAY_BIND_HOST=127.0.0.1
#   127.0.0.1 = localhost only (safe default) | works for max/tty modes but not sys/min
#   <LAN IP>  = expose only on one trusted network interface
#   0.0.0.0   = all interfaces (use firewalling)
GATEWAY_MASTER_KEY=sk-password
GATEWAY_OAUTH_MANAGEMENT_PASSWORD=password
GATEWAY_OAUTH_PORT=8317
GATEWAY_PROXY_PORT=4000
GATEWAY_API_KEY_ANTHROPIC=
GATEWAY_API_KEY_GOOGLE=
GATEWAY_API_KEY_OPENAI=
GATEWAY_API_KEY_OPENCODE_ZEN=
# Override to connect to a non-local gateway (leave empty to use local defaults):
GATEWAY_CLIENT_BASE_URL=
GATEWAY_CLIENT_API_KEY=

# vim: ft=sh
