#!/usr/bin/env bash
set -euo pipefail

SELECTOR_CHAIN="${XNDV_SELECTOR:-rofi dmenu fzf}"
CONTAINER_PREFIX="xndv"
XNDV_ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")
XNDV_HOST_DATA="${HOME}/.local/share/xndv"
XNDV_USER="xndv"
HERDR_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/herdr"
HERDR_CONTAINER_CONFIG_DIR="/home/${XNDV_USER}/.config/herdr-host"
HERDR_CONTAINER_CONFIG_DIR_LEGACY="/home/${XNDV_USER}/.config/herdr"
HERDR_SOCKET_FILE="${HERDR_CONFIG_DIR}/herdr.sock"

while [[ $# -gt 0 ]]; do
  case "$1" in
  -s | --selector)
    SELECTOR_CHAIN="$2"
    shift 2
    ;;
  *) break ;;
  esac
done

init_selector() {
  local s
  for s in $SELECTOR_CHAIN; do command -v "$s" &>/dev/null && {
    CONF_SELECTOR="$s"
    break
  }; done
  [[ -z "${CONF_SELECTOR:-}" ]] && echo "No selector found in: $SELECTOR_CHAIN" >&2 && exit 1
  return 0
}

# Read a single setting, preferring an exported value over the project .env so
# `FOO=1 xndv` still wins. Values are plain scalars — trailing comments and
# whitespace are dropped.
env_conf() {
  local var="$1" default="$2" value
  [[ -n "${!var:-}" ]] && return 0
  value=$(sed -n "s/^[[:space:]]*${var}=//p" "${XNDV_ROOT}/.env" 2>/dev/null | tail -1 || true)
  value="${value%%#*}"
  value="${value//[[:space:]]/}"
  printf -v "$var" '%s' "${value:-$default}"
}

env_conf ENABLE_AUDIO 0
env_conf AUDIO_MODE auto

ui() {
  local p="$1" f="${2:-}"
  case "$CONF_SELECTOR" in
  rofi) rofi -dmenu -i -p "$p" -filter "$f" ;;
  dmenu) dmenu -i -p "$p" ;;
  fzf) fzf --prompt "$p> " --reverse --height 40% --query "$f" --print-query | tail -1 || true ;;
  esac
}

append_herdr_env() {
  local -n out_args="$1"
  local container_config_dir="${2:-$HERDR_CONTAINER_CONFIG_DIR}"
  local herdr_socket_path herdr_client_socket_path

  [[ "${HERDR_ENV:-}" == "1" ]] || return 0
  [[ -n "${HERDR_PANE_ID:-}" && -n "${HERDR_SOCKET_PATH:-}" ]] || return 0

  herdr_socket_path="${HERDR_SOCKET_PATH/#${HERDR_CONFIG_DIR}/${container_config_dir}}"
  out_args+=(--env "HERDR_ENV=${HERDR_ENV}")
  out_args+=(--env "HERDR_PANE_ID=${HERDR_PANE_ID}")
  out_args+=(--env "HERDR_SOCKET_PATH=${herdr_socket_path}")
  out_args+=(--env "HERDR_SPLITS_CONFIG=${container_config_dir}/plugins/config/herdr-splits/herdr-splits.conf")

  if [[ -n "${HERDR_CLIENT_SOCKET_PATH:-}" ]]; then
    herdr_client_socket_path="${HERDR_CLIENT_SOCKET_PATH/#${HERDR_CONFIG_DIR}/${container_config_dir}}"
    out_args+=(--env "HERDR_CLIENT_SOCKET_PATH=${herdr_client_socket_path}")
  fi
}

container_herdr_config_dir() {
  local container="$1"
  local destinations

  destinations=$(docker inspect \
    -f '{{range .Mounts}}{{println .Destination}}{{end}}' \
    "$container" 2>/dev/null) || return 1
  grep -Fxq "$HERDR_CONTAINER_CONFIG_DIR" <<<"$destinations" && echo "$HERDR_CONTAINER_CONFIG_DIR" && return
  grep -Fxq "$HERDR_CONTAINER_CONFIG_DIR_LEGACY" <<<"$destinations" \
    && echo "$HERDR_CONTAINER_CONFIG_DIR_LEGACY"
}

# TTY: show command and prompt; GUI: auto-run
confirm_and_run() {
  local label="$1" cmd="$2"
  if [[ -t 0 && -t 1 ]]; then
    echo -e "\n\033[1;32m${label}:\033[0m\n$cmd\n"
    read -rp "Proceed? [Y/n] " confirm
    [[ "${confirm,,}" == "y" || -z "$confirm" ]] && eval "$cmd"
  else
    eval "$cmd"
  fi
}

require_sudo() {
  # Check if stdin (0) is NOT a terminal
  if [ ! -t 0 ]; then
    # rofi -e "Error: This command requires sudo. Please run it from a terminal."
    ui "Error: This command requires sudo. Please run \`$(basename "${0}")\` from a terminal."
    exit 1
  fi

  # Ensure sudo credentials are cached upfront — du and rm need root for Docker-owned dirs.
  # Prompt once here so subsequent sudo calls are silent.
  if ! sudo -n true 2>/dev/null; then
    echo "[xndv] sudo required for this command." >&2
    sudo -v || {
      echo "[xndv] sudo authentication failed." >&2
      exit 1
    }
  fi
}

#---------------------------------------------------------------------------
# LAUNCH
#---------------------------------------------------------------------------

# tag:src:[dest]:[options]
MOUNTS=(
  "priv:$HOME/.config/git"
  "priv:$HOME/.gnupg"
  "priv:$HOME/.ssh"
  "priv:$HOME/src.priv"
  "core:$HOME/src"
  "core:$HOME/sshfs::rshared"
  "data:${XNDV_HOST_DATA}:/home/${XNDV_USER}/.local/share"
  "data:${XNDV_HOST_DATA}/xndv/cache:/home/${XNDV_USER}/.cache"
  "misc:/media"
  "misc:/mnt"
  "misc:/srv"
)

if [[ -d "$HERDR_CONFIG_DIR" ]]; then
  MOUNTS+=("misc:${HERDR_CONFIG_DIR}:${HERDR_CONTAINER_CONFIG_DIR}")
fi

# Runner Definitions — how a mode is presented/launched
#   x11docker : desktop reality — x11docker + kitty window (foreground)
#   docker    : headless reality — docker run -d, re-enter via docker exec
# tag    : short label shown in the menu when a mode offers a runner choice
# shell  : container command for the runner (foreground GUI vs detached idle)
declare -A RUNNER_TAG=([x11docker]="x11" [docker]="tty")
declare -A RUNNER_SHELL=([x11docker]="kitty -T" [docker]="sleep infinity")
declare -A RUNNER_NOTE=([x11docker]="GUI window" [docker]="headless, background")

# A runner is usable on this host?
runner_available() {
  case "$1" in
  x11docker) command -v x11docker &>/dev/null ;;
  docker) command -v docker &>/dev/null ;;
  *) return 1 ;;
  esac
}

# Audio — host sound reaches the container through x11docker, so this applies
# to the x11 runner only. AUDIO_MODE holds an x11docker sound option written
# without its leading dashes, or "auto" to probe the host.

# Pick the best sound option this host actually offers:
#   pw-container present  PipeWire >= 1.4 — x11docker can hand out a sandboxed socket
#   pipewire-pulse host   no dedicated socket possible; share the existing one
#   sysbox runtime        container cannot reach the host runtime dir; go over TCP
audio_probe() {
  local runtime="$1" info

  command -v pw-container &>/dev/null && echo "pipewire" && return 0

  if command -v pactl &>/dev/null && info=$(LC_ALL=C pactl info 2>/dev/null); then
    [[ "$runtime" == "sysbox-runc" ]] && echo "pulseaudio=tcp" && return 0
    grep -qi pipewire <<<"$info" && echo "pulseaudio=host" && return 0
    echo "pulseaudio=socket" && return 0
  fi

  [[ -d /dev/snd ]] && echo "alsa" && return 0

  return 1
}

# Append the resolved sound option to an x11docker argument array.
append_audio_args() {
  local -n out_args="$1"
  local mode="$AUDIO_MODE" runtime="" arg

  [[ "$ENABLE_AUDIO" == "1" ]] || return 0

  for arg in "${out_args[@]}"; do
    [[ "$arg" == --runtime=* ]] && runtime="${arg#--runtime=}"
  done

  if [[ "$mode" == "auto" ]]; then
    mode=$(audio_probe "$runtime") || {
      echo "[xndv] ENABLE_AUDIO=1 but no host sound server found — launching without audio." >&2
      return 0
    }
  fi

  out_args+=("--${mode}")
}

# Mode Definitions
base() {
  RUNNERS=(x11docker)
  IMAGE="xen/dev"
  ARGS_X11DOCKER=(
    --clipboard
    --dbus
    --gpu
    --hostdisplay
    --network
    --share=/run/dbus/system_bus_socket
    --sudouser
    --user=RETAIN
    --verbose
  )
  ARGS_DOCKER=(
    --add-host=host.docker.internal:host-gateway
    --tmpfs=/tmp:exec
  )
  ENV=(
    "XNDV_HOSTNAME=localhost"
  )
  TAGS=(
    "core"
    "data"
  )
}

mode_max() {
  base
  DESC="Full access, direct GPU acceleration"
  ARGS_X11DOCKER+=(
    --gpu=direct
    --network=host
  )
  ARGS_DOCKER+=(
  )
  TAGS+=(
    "priv"
  )
}

# uses sysbox runtime for docker-in-docker
# persists docker storage in host data volume
# not compatible with x11docker --gpu=direct or --network=host
mode_sys() {
  base
  DESC="Docker-in-Docker via sysbox"
  IMAGE="xen/sys"
  RUNNERS=(x11docker docker)
  ARGS_X11DOCKER+=(
    --cap-default
    --gpu=virgl
    --runtime=sysbox-runc
    --share=/dev/dri
  )
  ARGS_DOCKER+=(
    --cap-add=NET_ADMIN
    --cap-add=NET_RAW
    --cap-add=SYS_ADMIN
    --runtime=sysbox-runc
  )
  ENV=(
    "XNDV_HOSTNAME=host.docker.internal"
  )
  MOUNTS+=(
    "sys:$HOME/.local/share/xndv/xndv/sysbox/docker:/var/lib/docker"
  )
  TAGS+=(
    "sys"
  )
}

mode_min() {
  base
  DESC="Minimal host access, max isolation"
  ARGS_X11DOCKER=(
    --gpu
    --hostdisplay
    --network
    --user=RETAIN
    --verbose
  )
  ENV=(
    "XNDV_HOSTNAME=host.docker.internal"
  )
  TAGS+=()
}

mode_tty() {
  DESC="TTY-only, no X11"
  RUNNERS=(docker)
  IMAGE="xen/dev"
  ARGS_DOCKER=(
    --add-host=host.docker.internal:host-gateway
    --network=host
    --tmpfs=/tmp:exec
  )
  ENV=(
    "XNDV_HOSTNAME=localhost"
  )
  TAGS=(
    "core"
    "data"
    "misc"
  )
}

resolve_container() {
  local requested="$1" container
  local containers=()

  mapfile -t containers < <(
    docker ps --filter "name=^${CONTAINER_PREFIX}-" --format '{{.Names}}' 2>/dev/null || true
  )

  if [[ -n "$requested" ]]; then
    for container in "${containers[@]}"; do
      [[ "$container" == "$requested" ]] && echo "$container" && return
    done
    echo "[xndv] container is not running: $requested" >&2
    return 1
  fi

  case "${#containers[@]}" in
  0)
    echo "[xndv] no running ${CONTAINER_PREFIX} containers" >&2
    return 1
    ;;
  1) echo "${containers[0]}" ;;
  *)
    echo "[xndv] multiple running containers; specify one:" >&2
    printf '  %s\n' "${containers[@]}" >&2
    return 1
    ;;
  esac
}

container_workdir() {
  local container="$1" source destination suffix
  local host_workdir host_home best_source="" best_destination=""

  host_workdir=$(pwd -P)
  host_home=$(readlink -f "$HOME")
  [[ "$host_workdir" == "$host_home" ]] && echo "/home/${XNDV_USER}" && return

  while IFS='|' read -r source destination; do
    [[ "$host_workdir" == "$source" || "$host_workdir" == "$source/"* ]] || continue
    if ((${#source} > ${#best_source})); then
      best_source="$source"
      best_destination="$destination"
    fi
  done < <(
    docker inspect \
      -f '{{range .Mounts}}{{printf "%s|%s\n" .Source .Destination}}{{end}}' \
      "$container" 2>/dev/null
  )

  if [[ -z "$best_source" ]]; then
    echo "[xndv] host directory is not mounted in $container: $host_workdir" >&2
    echo "[xndv] use -C to set a container directory" >&2
    return 1
  fi

  suffix="${host_workdir#"$best_source"}"
  [[ -z "$suffix" ]] && echo "$best_destination" || echo "${best_destination%/}$suffix"
}

enter_container() {
  local container="$1" workdir="$2"
  local exec_args=(-ti --workdir "$workdir")
  local herdr_container_config_dir initial_shell
  shift 2

  herdr_container_config_dir=$(container_herdr_config_dir "$container") \
    && append_herdr_env exec_args "$herdr_container_config_dir"

  # shellcheck disable=SC2016 # expanded by Bash inside the container
  initial_shell='
if (( $# == 0 )); then
  exec fish -i
elif (( $# == 1 )); then
  exec fish -i -C "$1"
fi
initial_command=$(fish -N -c "string join -- \" \" (string escape -- \$argv)" "$@") || exit
exec fish -i -C "$initial_command"
'

  echo "[xndv] entering $container at $workdir"
  exec docker exec "${exec_args[@]}" "$container" bash -ic "$initial_shell" xndv "$@"
}

enter_existing() {
  local container="" workdir=""
  local command_args=()

  while (($#)); do
    case "$1" in
    -C | --cwd)
      [[ $# -ge 2 ]] || { echo "[xndv] $1 requires a directory" >&2; return 2; }
      workdir="$2"
      shift 2
      ;;
    -h | --help)
      cat <<EOF
Usage: $(basename "$0") enter [CONTAINER] [-C DIR] [-- COMMAND [ARG...]]

Enter an existing xndv container, optionally run a Fish command, then remain in Fish.
CONTAINER defaults to XNDV_CONTAINER or the only running xndv container.
EOF
      return
      ;;
    --)
      shift
      command_args=("$@")
      break
      ;;
    -*)
      echo "[xndv] unknown enter option: $1" >&2
      return 2
      ;;
    *)
      [[ -z "$container" ]] || { echo "[xndv] unexpected argument: $1" >&2; return 2; }
      container="$1"
      shift
      ;;
    esac
  done

  container=$(resolve_container "${container:-${XNDV_CONTAINER:-}}")
  if [[ -n "$workdir" ]]; then
    [[ "$workdir" == /* ]] || { echo "[xndv] container directory must be absolute: $workdir" >&2; return 2; }
  else
    workdir=$(container_workdir "$container")
  fi

  enter_container "$container" "$workdir" "${command_args[@]}"
}

cmd_launch() {
  #---------------------------------------------------------------------------
  # 1. Action Selection — attach to existing container or create new instance
  #---------------------------------------------------------------------------
  local options=("+ New Instance") primary=() aux=() row name mode

  # Mapfile with a process substitution that formats the string immediately
  mapfile -t rows < <(docker ps --filter "name=^${CONTAINER_PREFIX}-" --format '{{.Names}}|{{.Label "xndv.mode"}}' 2>/dev/null || true)

  for row in "${rows[@]}"; do
    IFS='|' read -r name mode <<<"$row"
    [[ -z "$name" ]] && continue

    # Format the row; default mode to "aux" if empty
    printf -v formatted "%-3s │ %s" "${mode:-aux}" "$name"

    # Sort into respective arrays based on mode
    [[ "${mode:-aux}" == "aux" ]] && aux+=("$formatted") || primary+=("$formatted")
  done

  options+=("${primary[@]}" "${aux[@]}")
  sel=$(printf '%s\n' "${options[@]}" | ui "xndv")
  [[ -z "$sel" ]] && exit 0
  if [[ "$sel" != "+ New Instance" ]]; then
    container="${sel##* }"
    enter_container "$container" "/home/${XNDV_USER}"
  fi

  #---------------------------------------------------------------------------
  # 2. Mode Selection — choose environment preset × runner, filtered to what
  # this host can actually run (image present + runner available). A runner tag
  # (x11/tty) is shown only when a mode offers more than one available runner.
  #---------------------------------------------------------------------------
  # anchor on the mode_ prefix — a bare grep also catches functions that merely
  # contain "mode_" somewhere in their name
  modes=($(declare -F | sed -n 's/^declare -f mode_//p'))
  menu=()
  for m in "${modes[@]}"; do
    # probe mode metadata in a subshell so mode-internal MOUNTS+=/ENV+= appends
    # don't leak between modes (the selected mode is re-evaluated cleanly below)
    IFS='|' read -r p_image p_desc p_runners < <(
      "mode_$m"
      printf '%s|%s|%s\n' "$IMAGE" "$DESC" "${RUNNERS[*]}"
    )
    docker image inspect "$p_image" &>/dev/null || continue
    avail=()
    for r in $p_runners; do runner_available "$r" && avail+=("$r"); done
    [[ ${#avail[@]} -eq 0 ]] && continue
    for r in "${avail[@]}"; do
      if [[ ${#avail[@]} -gt 1 ]]; then
        printf -v line "%-12s  │ %s (%s)" "${m}·${RUNNER_TAG[$r]}" "$p_desc" "${RUNNER_NOTE[$r]}"
      else
        printf -v line "%-12s │ %s" "$m" "$p_desc"
      fi
      menu+=("$line")
    done
  done
  [[ ${#menu[@]} -eq 0 ]] && echo "[xndv] No runnable modes (missing images or runners)" >&2 && exit 1

  m_sel=$(ui "Mode" <<<"$(printf '%s\n' "${menu[@]}")")
  [[ -z "$m_sel" ]] && exit 0

  # Parse "mode" or "mode·tag" from the selection; resolve the runner.
  sel_label="${m_sel%% *}"
  mode="${sel_label%%·*}"
  if [[ "$sel_label" == *·* ]]; then
    tag="${sel_label##*·}"
    for r in "${!RUNNER_TAG[@]}"; do [[ "${RUNNER_TAG[$r]}" == "$tag" ]] && RUNNER="$r"; done
  else
    # single available runner — read RUNNERS via subshell (avoid leaking MOUNTS)
    read -r p_runners < <("mode_$mode"; echo "${RUNNERS[*]}")
    for r in $p_runners; do runner_available "$r" && RUNNER="$r" && break; done
  fi

  #---------------------------------------------------------------------------
  # 3. Container Name — pre-filled with mode-based default
  #---------------------------------------------------------------------------
  inst=$(ui "Container Name" "${CONTAINER_PREFIX}-$mode-" <<<"")
  [[ -z "$inst" ]] && inst="${CONTAINER_PREFIX}-$mode"

  #---------------------------------------------------------------------------
  # 4. Mount Selection — toggle volume mounts before launching
  #---------------------------------------------------------------------------
  "mode_$mode"
  symbol_arrow=' -> '
  declare -A selected
  for i in "${!MOUNTS[@]}"; do
    IFS=':' read -r tag src dst opts <<<"${MOUNTS[$i]}"
    for dt in "${TAGS[@]:-}"; do
      [[ -n "$tag" && "$tag" == "$dt" ]] && selected[$i]=1
    done
    [[ "$src" == "$HERDR_CONFIG_DIR" && -S "$HERDR_SOCKET_FILE" ]] && selected[$i]=1
  done

  while true; do
    menu_lines=("▶ LAUNCH")
    for i in "${!MOUNTS[@]}"; do
      state="[ ]"
      [[ -n "${selected[$i]:-}" ]] && state="[x]"
      IFS=':' read -r tag src dst opts <<<"${MOUNTS[$i]}"
      printf -v line "%s %-4s │ %s%s" "$state" "$tag" "$src" "${dst:+$symbol_arrow$dst}"
      menu_lines+=("$line")
    done

    choice=$(ui "Mounts" <<<"$(printf '%s\n' "${menu_lines[@]}")")

    [[ -z "$choice" || "$choice" == "▶ LAUNCH" ]] && break

    # Bash-fu: Strip prefix up to "│ ", then strip everything from arrow symbol onwards
    choice_path="${choice#*│ }"
    choice_path="${choice_path%%${symbol_arrow}*}"

    for i in "${!MOUNTS[@]}"; do
      IFS=':' read -r tag src dst opts <<<"${MOUNTS[$i]}"
      if [[ "$src" == "$choice_path" ]]; then
        [[ -n "${selected[$i]:-}" ]] && unset "selected[$i]" || selected[$i]=1
        break
      fi
    done
  done

  #---------------------------------------------------------------------------
  # 5. Build Command & Confirm Launch
  #---------------------------------------------------------------------------
  vol_args=()
  env_args=()
  herdr_mount_selected=0
  for i in "${!selected[@]}"; do
    IFS=':' read -r tag src dst opts <<<"${MOUNTS[$i]}"
    [[ -z "$dst" ]] && dst="${src/#$HOME\///home/${XNDV_USER}/}"
    [[ ! -d "$src" ]] && mkdir -p "$src"
    vol_args+=("--volume" "$src:$dst${opts:+:$opts}")
    [[ "$src" == "$HERDR_CONFIG_DIR" ]] && herdr_mount_selected=1
  done

  "mode_$mode"
  env_args+=(--env "XNDV_MODE=${mode}")
  for env_var in "${ENV[@]}"; do
    env_args+=(--env "$env_var")
  done
  [[ "$herdr_mount_selected" == "1" ]] && append_herdr_env env_args
  SHELL_CMD="${RUNNER_SHELL[$RUNNER]}"
  ARGS_DOCKER+=(--label xndv.mode=$mode)
  if [[ "$RUNNER" == "x11docker" ]]; then
    append_audio_args ARGS_X11DOCKER
    cmd="x11docker --name $inst ${ARGS_X11DOCKER[*]} -- ${ARGS_DOCKER[*]} ${env_args[*]} ${vol_args[*]} -- $IMAGE $SHELL_CMD $inst"
  else
    cmd="docker run -d --init --name $inst ${ARGS_DOCKER[*]} ${env_args[*]} ${vol_args[*]} $IMAGE $SHELL_CMD"
  fi

  confirm_and_run "Generated Command" "$cmd"
}

#---------------------------------------------------------------------------
# CLEAN
#---------------------------------------------------------------------------

# Host-persistent data dirs for selective cleanup
# Format: tag:path:label
#   cache — safe to delete; data is auto-regenerated (binaries, analytics, caches)
#   state — active config or auth; deletion causes friction (re-login, reconfiguration)
DIRS=(
  "cache:${XNDV_HOST_DATA}/xndv/ai/gateway/postgres:LiteLLM Postgres"
  "cache:${XNDV_HOST_DATA}/xndv/ai/gateway/redis:LiteLLM Redis"
  "cache:${XNDV_HOST_DATA}/xndv/ai/open-webui:Open WebUI data"
  "cache:${XNDV_HOST_DATA}/xndv/aztec:Aztec versioned binaries"
  "cache:${XNDV_HOST_DATA}/xndv/cache:Container ~/.cache"
  "cache:${XNDV_HOST_DATA}/xndv/herdr-plugins:Host herdr plugins (restore: make install-herdr)"
  "cache:${XNDV_HOST_DATA}/xndv/mcp/aztec:Aztec MCP server data"
  "cache:${XNDV_HOST_DATA}/xndv/mcp/noir:Noir MCP repos"
  "cache:${XNDV_HOST_DATA}/xndv/sysbox/docker:Sysbox /var/lib/docker storage"
  "state:${XNDV_HOST_DATA}/xndv/ai/gateway/cliproxyapi-auth:OAuth tokens (re-login required)"
)

cmd_clean() {
  require_sudo

  if [[ ! -d "$XNDV_HOST_DATA" ]]; then
    echo "[xndv] Data directory not found: $XNDV_HOST_DATA" >&2
    exit 1
  fi

  #---------------------------------------------------------------------------
  # 1. Measure disk usage — cache entries sorted by size desc, state at bottom
  #---------------------------------------------------------------------------
  # Build a sorted index into DIRS: cache entries (size desc) then state entries
  local cache_idx=() state_idx=() sorted_idx=()
  local sizes=()
  for i in "${!DIRS[@]}"; do
    IFS=':' read -r tag path label <<<"${DIRS[$i]}"
    local size="-"
    [[ -d "$path" ]] && size=$(sudo du -sh "$path" 2>/dev/null | cut -f1)
    sizes[$i]="$size"
    [[ "$tag" == "state" ]] && state_idx+=("$i") || cache_idx+=("$i")
  done

  # Sort cache indices by size descending
  local cache_sorted
  mapfile -t cache_sorted < <(
    for i in "${cache_idx[@]}"; do printf '%s %s\n' "${sizes[$i]}" "$i"; done |
      sort -k1 -h -r | awk '{print $2}'
  )
  sorted_idx=("${cache_sorted[@]}" "${state_idx[@]}")

  #---------------------------------------------------------------------------
  # 2. Directory Selection — toggle dirs to delete, confirm with ▶ CLEAN
  #---------------------------------------------------------------------------
  declare -A selected
  while true; do
    local menu_lines=("▶ CLEAN")
    for i in "${sorted_idx[@]}"; do
      IFS=':' read -r tag path label <<<"${DIRS[$i]}"
      local chk="[ ]"
      [[ -n "${selected[$i]:-}" ]] && chk="[x]"
      local rel="${path#"${XNDV_HOST_DATA}/"}"
      local line
      printf -v line "%s %-5s  %6s  %-46s %s" "$chk" "$tag" "${sizes[$i]}" "$rel" "$label"
      menu_lines+=("$line")
    done

    local choice
    choice=$(ui "Clean" <<<"$(printf '%s\n' "${menu_lines[@]}")")

    [[ -z "$choice" ]] && exit 0
    [[ "$choice" == "▶ CLEAN" ]] && break

    # Toggle selection by stripping checkbox prefix then extracting relpath (field 3)
    local choice_rel
    choice_rel=$(sed 's/^\[.\] //' <<<"$choice" | awk '{print $3}')
    for i in "${sorted_idx[@]}"; do
      IFS=':' read -r tag path label <<<"${DIRS[$i]}"
      local rel="${path#"${XNDV_HOST_DATA}/"}"
      if [[ "$rel" == "$choice_rel" ]]; then
        if [[ -n "${selected[$i]:-}" ]]; then unset "selected[$i]"; else selected[$i]=1; fi
        break
      fi
    done
  done

  local selected_paths=() selected_state_paths=()
  for i in "${!selected[@]}"; do
    IFS=':' read -r tag path label <<<"${DIRS[$i]}"
    selected_paths+=("$path")
    [[ "$tag" == "state" ]] && selected_state_paths+=("$path")
  done

  [[ ${#selected_paths[@]} -eq 0 ]] && exit 0

  #---------------------------------------------------------------------------
  # 3. State Warning — extra TTY confirmation for auth/config directories
  #---------------------------------------------------------------------------
  if [[ ${#selected_state_paths[@]} -gt 0 ]]; then
    echo ""
    echo "[xndv] WARNING: the following require re-login or reconfiguration after deletion:"
    for p in "${selected_state_paths[@]}"; do
      echo "  [state]  $p"
    done
    echo ""
    read -rp "Type YES to confirm deletion of state directories: " confirm_state
    [[ "$confirm_state" != "YES" ]] && echo "[xndv] Cancelled." >&2 && exit 0
  fi

  #---------------------------------------------------------------------------
  # 4. Build Command & Confirm Deletion
  #---------------------------------------------------------------------------
  local total_freed
  total_freed=$(sudo du -shc "${selected_paths[@]}" 2>/dev/null | tail -1 | cut -f1)
  local n="${#selected_paths[@]}" noun
  [[ "$n" -eq 1 ]] && noun="directory" || noun="directories"

  local cmd="sudo rm -rf $(printf '"%s" ' "${selected_paths[@]}")"
  echo ""
  echo "[xndv] Will delete ${n} ${noun} (~${total_freed}):"
  for p in "${selected_paths[@]}"; do echo "  $p"; done

  confirm_and_run "Delete Command" "$cmd"
}

#---------------------------------------------------------------------------
# MAIN
#---------------------------------------------------------------------------

main() {
  if [[ "${1:-}" == "enter" ]]; then
    shift
    enter_existing "$@"
    return
  fi

  init_selector
  cmds=($(declare -F | sort -r | grep " cmd_" | sed 's/.* cmd_//'))
  c_sel=$(ui "xndv" <<<"$(printf '%s\n' "${cmds[@]}")")
  [[ -z "$c_sel" ]] && exit 0
  "cmd_${c_sel}"
}

main "$@"

